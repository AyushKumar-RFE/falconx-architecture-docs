// FalconX C4 model (LikeC4) — AWS cloud deploy + icons
// Run: npm run c4:dev | npm run c4:validate | npm run build

specification {
  element actor {
    style {
      shape person
      color secondary
    }
  }
  element system {
    style {
      color muted
    }
  }
  // Apps / APIs on EKS (Argo/Helm)
  element eks {
    style {
      shape rectangle
      icon aws:elastic-kubernetes-service
      color primary
    }
  }
  // AWS Lambda (settlement path; LocalStack locally)
  element lambda {
    style {
      shape rectangle
      icon aws:lambda
      color amber
    }
  }
  // Data stores / buses
  element store {
    style {
      shape storage
      color indigo
    }
  }
}

model {
  customer = actor 'Customer' {
    description 'Places bets and watches markets via B2C'
  }
  operator = actor 'Operator' {
    description 'Back-office and B2B operations'
  }

  betfair = system 'Betfair' {
    description 'Exchange streaming + catalogue APIs (or emulator locally)'
  }
  bookmakerFeeds = system 'Bookmaker / Fancy feeds' {
    description 'Third-party odds feeds; often via VPN'
  }

  falconx = system 'FalconX' {
    description 'Sports betting platform on AWS — EKS workloads, Lambda settlement, Aurora/ElastiCache/MSK'
    icon aws:cloud-formation

    // ── Frontends (EKS) ──────────────────────────────────────────
    feB2C = eks 'Frontend-B2C' {
      technology 'Next.js · EKS'
      description 'Customer UI (:3001 local fullstack)'
      style {
        shape browser
        icon tech:nextjs
      }
    }
    feB2B = eks 'Frontend-B2B' {
      technology 'Next.js · EKS'
      description 'B2B / operator UI (:3000 local fullstack)'
      style {
        shape browser
        icon tech:nextjs
      }
    }
    backOffice = eks 'BackOffice' {
      technology 'Go · EKS'
      description 'Back-office APIs'
      style { icon tech:go }
    }

    // ── Money path ───────────────────────────────────────────────
    userSvc = eks 'User' {
      technology 'Python / FastAPI · EKS'
      description 'Identity, wallets, hierarchy (:8001)'
      style { icon tech:python }
    }
    bettingEngine = eks 'BettingEngine' {
      technology 'Python / FastAPI · EKS'
      description 'Place bets + settlement orchestration API (:8002). Triggers Lambda settlement.'
      style { icon tech:python }
    }
    bets = eks 'Bets' {
      technology 'Go / Fiber · EKS'
      description 'Bets API; schema owned by BettingEngine'
      style { icon tech:go }
    }
    settlement = lambda 'Settlement lambdas' {
      technology 'AWS Lambda (+ LocalStack locally)'
      description 'Async settlement workers (EventBridge → SQS → Lambda). Secrets read at runtime.'
    }

    // ── Odds & catalogue ─────────────────────────────────────────
    betfairStreaming = eks 'BetfairStreaming' {
      technology 'Go · EKS'
      description 'stream (push) | catalogue-sync (loop) | dlq-worker'
      style { icon tech:go }
    }
    dataAggregator = eks 'DataAggregator' {
      technology 'Go · EKS'
      description 'Kafka consumer → aggregated market data (event-driven, not polling)'
      style { icon tech:go }
    }
    markets = eks 'Markets' {
      technology 'Go · EKS'
      description 'Market catalogue / read API (:8012)'
      style { icon tech:go }
    }
    marketsProxy = eks 'MarketsProxy' {
      technology 'Go · EKS'
      description 'Proxy in front of markets path'
      style { icon tech:go }
    }
    frontMarket = eks 'FrontMarket' {
      technology 'Go · EKS'
      description 'Market read + odds SSE hub (:8010)'
      style { icon tech:go }
    }
    bookmakerData = eks 'BookmakerData' {
      technology 'Python / FastAPI · EKS'
      description 'Bookmaker odds API + worker (:8003). Worker polls/feeds upstream (VPN in some stacks).'
      style { icon tech:python }
    }
    fancyData = eks 'FancyData' {
      technology 'Python / FastAPI · EKS'
      description 'Fancy markets API + worker (:8004). Worker polls/feeds upstream (VPN in some stacks).'
      style { icon tech:python }
    }
    manualData = eks 'ManualDataManagement' {
      technology 'Python / FastAPI · EKS'
      description 'Operator odds/suspend overrides (:8008)'
      style { icon tech:python }
    }
    emulators = eks 'emulators' {
      technology 'Go · local/CI only'
      description 'Betfair mock REST/stream — not a prod AWS service'
      style {
        icon tech:go
        color muted
      }
    }

    // ── Other product APIs (EKS) ─────────────────────────────────
    casino = eks 'CasinoManagement' {
      technology 'Python / FastAPI · EKS'
      description 'Casino management (:8005)'
      style { icon tech:python }
    }
    liveScore = eks 'LiveScore' {
      technology 'Python / FastAPI · EKS'
      description 'Live scores (:8006)'
      style { icon tech:python }
    }
    liveTv = eks 'LiveTV' {
      technology 'Python / FastAPI · EKS'
      description 'Live TV (:8007)'
      style { icon tech:python }
    }

    // ── AWS data plane ───────────────────────────────────────────
    postgres = store 'Aurora PostgreSQL' {
      technology 'Amazon Aurora (PostgreSQL)'
      description 'System of record (local: Postgres :5432)'
      icon aws:aurora
    }
    redis = store 'ElastiCache Valkey' {
      technology 'Amazon ElastiCache (Valkey)'
      description 'Odds cache, pub/sub, sessions (local: Valkey :6379)'
      icon aws:elasti-cache
      style { shape storage }
    }
    kafka = store 'Amazon MSK' {
      technology 'Amazon MSK (Kafka)'
      description 'Async integration bus (local: Kafka :9092)'
      icon aws:managed-streaming-for-apache-kafka
      style { shape queue }
    }

    // Client → API
    feB2C -> bettingEngine 'Place bets (HTTPS)'
    feB2C -> frontMarket 'Markets / SSE (push to browser)'
    feB2C -> userSvc 'Auth / wallet (HTTPS)'
    feB2B -> backOffice 'Operate (HTTPS)'

    // Money
    bettingEngine -> userSvc 'Limits / balances'
    bettingEngine -> bets 'Persist bets'
    bettingEngine -> settlement 'Settle via EventBridge/SQS (async)'
    bettingEngine -> kafka 'Domain events (produce)'
    settlement -> userSvc 'Balance updates'
    settlement -> postgres 'Writes'
    bets -> postgres 'Reads/writes'
    userSvc -> postgres 'Reads/writes'
    userSvc -> redis 'Cache'

    betfairStreaming -> kafka 'Market updates (produce)'
    betfairStreaming -> redis 'Odds blobs / change notices'
    betfairStreaming -> postgres 'Catalogue upserts'
    dataAggregator -> kafka 'Consumes (event-driven)'
    dataAggregator -> postgres 'Aggregates'
    bookmakerData -> redis 'Publish odds'
    fancyData -> redis 'Publish odds'
    manualData -> redis 'Override notices'
    frontMarket -> redis 'Read odds / SSE'
    frontMarket -> markets 'Catalogue'
    marketsProxy -> markets 'Proxy'
    markets -> postgres 'Catalogue'
    emulators -> betfairStreaming 'Emulator lane (local/CI only)'
  }

  customer -> falconx.feB2C 'Uses'
  operator -> falconx.feB2B 'Uses'
  operator -> falconx.backOffice 'Uses'

  // External feeds — push vs poll (amber dotted = poll/sync loop)
  betfair -> falconx.betfairStreaming 'Market stream (push)'
  betfair -> falconx.betfairStreaming 'Catalogue sync loop (poll/reconcile — set interval in service config)' {
    style {
      color amber
      line dotted
    }
  }
  bookmakerFeeds -> falconx.bookmakerData 'Odds feed / poll upstream (interval in worker config)' {
    style {
      color amber
      line dotted
    }
  }
  bookmakerFeeds -> falconx.fancyData 'Fancy feed / poll upstream (interval in worker config)' {
    style {
      color amber
      line dotted
    }
  }
}

views {
  view index {
    title 'FalconX — System context'
    description 'AWS-hosted sports betting platform and its external actors/systems'
    include *
  }

  view of falconx {
    title 'FalconX — Containers (apps)'
    description 'EKS (apps) · Lambda (settlement) · Aurora · ElastiCache · MSK. Amber dotted edges = poll/sync loops. Edge/GitOps live in Infra views.'
    include *
    exclude waf, cloudFront, traefik, argoCD, ecr, s3static, secretsMgr, auroraDa, debezium, gcSensor
  }

  view money of falconx {
    title 'Money path'
    description 'EKS APIs + Lambda settlement + Aurora/ElastiCache/MSK'
    include
      customer,
      feB2C,
      userSvc,
      bettingEngine,
      bets,
      settlement,
      postgres,
      kafka,
      redis
  }

  view odds of falconx {
    title 'Odds & catalogue'
    description 'Push stream vs poll/sync (amber dotted). Confirm exact intervals in each worker/service config.'
    include
      betfair,
      emulators,
      betfairStreaming,
      dataAggregator,
      bookmakerData,
      fancyData,
      manualData,
      frontMarket,
      markets,
      marketsProxy,
      redis,
      kafka,
      postgres,
      feB2C,
      customer
  }
}
