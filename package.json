{
  "name": "falconx-architecture-docs",
  "version": "1.0.0",
  "private": true,
  "description": "FalconX architecture SSOT — C4, ADRs, service catalog, infra, critical flows",
  "type": "module",
  "scripts": {
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "c4:dev": "likec4 start c4",
    "c4:build": "likec4 build c4 -o docs/public/c4",
    "c4:validate": "likec4 validate c4",
    "build": "npm run c4:build && npm run docs:build"
  },
  "devDependencies": {
    "likec4": "^1.36.0",
    "mermaid": "^11.6.0",
    "vitepress": "^1.6.3",
    "vitepress-plugin-mermaid": "^2.0.17"
  },
  "engines": {
    "node": ">=20"
  }
}
